# Токен от @BotFather
BOT_TOKEN=123456:ABC...
# Telegram ID админов через запятую (узнать свой: @userinfobot)
ADMIN_IDS=
# Путь к базе SQLite
DB_PATH=data/bot.db
# Страницы ANC, с которых собираются ссылки на PDF (через запятую)
ANC_SOURCE_PAGES=https://cetatenie.just.ro/stadiu-dosar/
# Регулярка для фильтра ссылок на PDF (пусто = все PDF со страниц)
ANC_PDF_FILTER=
# HTTP-прокси для запросов к ANC, например http://user:pass@1.2.3.4:8080
# (нужен, если сайт ANC не отвечает с IP вашего сервера)
ANC_PROXY=
# Как часто проверять сайт ANC, в минутах
CHECK_INTERVAL_MIN=30
